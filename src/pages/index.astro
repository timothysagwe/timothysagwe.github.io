---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const experience = [
	{
		industry: "Financial Services",
		role: "Technology Risk & Controls Analyst",
		period: "Aug 2025 – Present",
		bullets: [
			"Triaged and assessed technology control issues raised through internal referrals, reviewing stakeholder communications and standards alignment to support timely escalation within the formal issues management process.",
			"Produced audit-grade issue documentation including evidence logs and trackers, strengthening traceability and defensibility for assurance and regulatory review.",
			"Translated complex technology and security standards into clear risk narratives, mapping control gaps to policy requirements and articulating exposure to senior stakeholders to support risk acceptance and remediation decisions.",
			"Coordinated across technology, fraud, and governance teams to clarify control requirements and monitor remediation actions, reducing missed deliverables and strengthening first-line risk ownership.",
			"Monitored vulnerability remediation status using Veracode and Prisma Cloud, identifying SLA-breached findings and engaging engineering teams to drive timely closure.",
		],
	},
	{
		industry: "UK Armed Forces",
		role: "Operations & Logistics Specialist",
		period: "Jan 2021 – Aug 2025",
		bullets: [
			"Promoted to supervisory responsibility for a shift of seven personnel at a specialist training station, allocating tasks and monitoring delivery standards.",
			"Maintained uninterrupted operations for up to 1,000 personnel across every shift, adapting plans based on resource availability and holding quality control accountability throughout.",
			"Deployed on multiple overseas assignments lasting several months, delivering operational support in austere environments away from base infrastructure.",
			"Operated within a diverse, multinational environment alongside UK and international personnel, maintaining professional standards under operational conditions.",
		],
	},
];

const skills = [
	{
		category: "GRC & Risk Management",
		items: ["Technology Risk Assessment", "Control Design & Testing", "Issues Management", "Vulnerability Management", "NIST CSF", "ISO 27001", "CRISC Domains"],
	},
	{
		category: "Tools & Platforms",
		items: ["ServiceNow GRC", "Veracode", "Prisma Cloud", "Tableau", "SQL", "MS Excel & PowerPoint"],
	},
];
---

<PageLayout meta={{ title: "Timothy Sagwe — Technology Risk & GRC" }}>
	<section class="mb-14">
		<h1 class="title mb-4">Timothy Sagwe</h1>
		<p class="text-accent mb-1 font-semibold">Technology Risk & Controls Analyst</p>
		<p class="text-muted mb-6 text-sm">United Kingdom</p>
		<p class="mb-4">
			GRC professional working in financial services technology risk, with a background in high-pressure
			operational environments. I assess technology control issues, translate security standards into
			actionable risk narratives, and support engineering and governance teams in driving remediation.
		</p>
		<p class="mb-6">
			Outside of work I build tools to help others practice GRC skills — see my
			<a class="cactus-link" href="/projects/">projects</a>.
		</p>
	</section>

	<section class="mb-14">
		<h2 class="title mb-8 text-xl">Experience</h2>
		<div class="space-y-10">
			{
				experience.map((job) => (
					<div>
						<div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
							<div>
								<span class="font-semibold">{job.role}</span>
								<span class="text-muted mx-2 text-sm">·</span>
								<span class="text-muted text-sm">{job.industry}</span>
							</div>
							<span class="text-muted text-sm">{job.period}</span>
						</div>
						<ul class="text-muted space-y-2 border-l-2 pl-4 text-sm" role="list">
							{job.bullets.map((b) => (
								<li>{b}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="mb-14">
		<h2 class="title mb-8 text-xl">Skills & Qualifications</h2>
		<div class="space-y-6">
			{
				skills.map((group) => (
					<div>
						<h3 class="text-accent mb-2 text-sm font-semibold uppercase tracking-wide">
							{group.category}
						</h3>
						<div class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="border-muted text-muted rounded border px-2 py-0.5 text-xs">
									{item}
								</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section>
		<h2 class="title mb-6 text-xl">Get in Touch</h2>
		<p class="mb-6 text-sm">Open to new opportunities and collaboration.</p>
		<div class="flex flex-col gap-3 sm:flex-row sm:gap-6">
			<a
				class="hover:text-accent flex items-center gap-2 text-sm transition-colors"
				href="mailto:timothysagwe@icloud.com"
			>
				<Icon aria-hidden="true" class="h-5 w-5 shrink-0" name="mdi:email-outline" />
				timothysagwe@icloud.com
			</a>
			<a
				class="hover:text-accent flex items-center gap-2 text-sm transition-colors"
				href="https://www.linkedin.com/in/timothysagwe"
				rel="noreferrer"
				target="_blank"
			>
				<Icon aria-hidden="true" class="h-5 w-5 shrink-0" name="mdi:linkedin" />
				linkedin.com/in/timothysagwe
			</a>
		</div>
	</section>
</PageLayout>
