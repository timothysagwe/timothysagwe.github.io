---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Projects built by Timothy Sagwe — GRC, cybersecurity, and web development.",
	title: "Projects",
};

const projects: { title: string; description: string; tech: string[]; demo?: string; highlights: string[] }[] = [
	{
		title: "GRC Platform",
		description:
			"A hands-on sandbox for anyone looking to build practical skills in Governance, Risk & Compliance. GRC is a discipline that sits at the intersection of technology risk, regulatory compliance, and organisational resilience — yet most learning resources are theoretical. This platform gives practitioners a realistic environment to work through the day-to-day activities of a GRC professional: identifying and scoring risks, implementing and testing controls, tracking compliance obligations, and managing security incidents.",
		tech: [],
		demo: "https://timothysagwe.github.io/grc-platform/",
		highlights: [
			"Risk register — log technology and operational risks, assign ownership, and track treatment actions",
			"Controls library — document preventive and detective controls mapped to frameworks such as ISO 27001 and NIST CSF",
			"Compliance tracker — monitor regulatory obligations, record evidence, and surface gaps",
			"Incident log — capture security incidents, severity, and lessons learned",
			"Dashboard — live view of the organisation's risk posture and compliance status",
		],
	},
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-8">Projects</h1>
	<div class="space-y-12">
		{
			projects.map((project) => (
				<article class="border-accent rounded-lg border p-6">
					<div class="mb-4 flex flex-wrap items-start justify-between gap-4">
						<h2 class="text-xl font-bold">{project.title}</h2>
						{project.demo && (
							<a
								class="cactus-link text-sm font-semibold"
								href={project.demo}
								rel="noreferrer"
								target="_blank"
							>
								Live Demo →
							</a>
						)}
					</div>
					<p class="mb-4 text-sm">{project.description}</p>
					<ul class="mb-4 list-inside list-disc space-y-1 text-sm" role="list">
						{project.highlights.map((h) => (
							<li>{h}</li>
						))}
					</ul>
					{project.tech.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{project.tech.map((tag) => (
								<span class="bg-accent/10 text-accent rounded px-2 py-0.5 text-xs font-medium">
									{tag}
								</span>
							))}
						</div>
					)}
				</article>
			))
		}
	</div>
</PageLayout>
